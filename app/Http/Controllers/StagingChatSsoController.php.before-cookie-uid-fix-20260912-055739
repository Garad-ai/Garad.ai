<?php

namespace App\Http\Controllers;

use Illuminate\Http\Request;
use Illuminate\Http\RedirectResponse;
use Illuminate\Support\Facades\Auth;
use Illuminate\Support\Str;

class StagingChatSsoController extends Controller
{
    public function handle(Request $request): RedirectResponse
    {
        /*
         * LibreChat/OIDC interaction UID.
         * Save before Garad AI login.
         */
        $requestUid = trim((string) $request->query('uid', ''));

        if ($requestUid !== '') {
            $request->session()->put(
                'staging_chat_oidc_uid',
                $requestUid
            );
        }

        /*
         * Garad AI is the ONLY login system.
         */
        if (! Auth::check()) {
            return redirect()->route('login', [
                'redirect' => 'stagingChat:' . $requestUid,
            ]);
        }

        /*
         * If UID exists in current URL use it.
         * Otherwise recover the UID saved before login.
         */
        $uid = $requestUid;

        if ($uid === '') {
            $uid = trim((string) $request->session()->pull(
                'staging_chat_oidc_uid',
                ''
            ));
        } else {
            $request->session()->forget('staging_chat_oidc_uid');
        }

        abort_if(
            $uid === '',
            400,
            'Missing staging chat authentication session.'
        );

        /*
         * SSO bridge configuration.
         */
        $secret = trim((string) config(
            'garad_staging_sso.secret',
            ''
        ));

        $bridge = rtrim(
            trim((string) config(
                'garad_staging_sso.bridge_url',
                ''
            )),
            '/'
        );

        abort_if(
            $secret === '',
            500,
            'Staging SSO secret is missing.'
        );

        abort_if(
            $bridge === '',
            500,
            'Staging SSO bridge URL is missing.'
        );

        /*
         * Real Garad AI user.
         */
        $user = Auth::user();

        abort_if(
            ! $user,
            401,
            'Garad AI authenticated user was not found.'
        );

        $email = strtolower(
            trim((string) data_get($user, 'email', ''))
        );

        abort_if(
            $email === '',
            422,
            'Garad AI user email is missing.'
        );

        /*
         * Real Garad user name.
         */
        $firstName = trim(
            (string) data_get($user, 'name', '')
        );

        $surname = trim(
            (string) data_get($user, 'surname', '')
        );

        $name = trim(
            $firstName . ' ' . $surname
        );

        if ($name === '') {
            $name = $email;
        }

        /*
         * Keep identity payload intentionally minimal
         * until core SSO is confirmed stable.
         *
         * Avatar and role will be added AFTER this test.
         */
        $payload = [
            'v'     => 1,
            'uid'   => $uid,
            'sub'   => (string) $user->getAuthIdentifier(),
            'email' => $email,
            'name'  => $name,
            'iat'   => time(),
            'exp'   => time() + 90,
            'nonce' => Str::random(40),
        ];

        $json = json_encode(
            $payload,
            JSON_UNESCAPED_SLASHES |
            JSON_UNESCAPED_UNICODE |
            JSON_THROW_ON_ERROR
        );

        $encoded = rtrim(
            strtr(
                base64_encode($json),
                '+/',
                '-_'
            ),
            '='
        );

        $signature = hash_hmac(
            'sha256',
            $encoded,
            $secret
        );

        /*
         * Continue authentication through Garad bridge.
         */
        return redirect()->away(
            $bridge .
            '/garad/complete?payload=' .
            rawurlencode($encoded) .
            '&sig=' .
            rawurlencode($signature)
        );
    }

    public function logout(Request $request): RedirectResponse
    {
        Auth::guard('web')->logout();

        $request->session()->invalidate();
        $request->session()->regenerateToken();

        return redirect()->route('login', [
            'redirect' => 'stagingChat',
        ]);
    }
}
